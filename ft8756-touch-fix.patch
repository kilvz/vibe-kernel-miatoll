+/* FT8756 replacement panel boot revive (v6): the replacement
+ * panel merges touch/display lines, so the IC needs a hardware
+ * reset after the boot-time firmware re-flash before it will
+ * accept register writes. Pulse the reset GPIO, then run the
+ * suspend->resume path (fts_ex_mode_recovery), the same as a
+ * manual screen off/on. */
+static void fts_boot_revive_work(struct work_struct *work)
+{
+	struct fts_ts_data *ts_data = container_of(work, struct fts_ts_data,
+						    boot_revive_work.work);
+
+	FTS_INFO("boot revive: reset pulse + suspend->resume");
+	gpio_direction_output(ts_data->pdata->reset_gpio, 0);
+	msleep(20);
+	gpio_direction_output(ts_data->pdata->reset_gpio, 1);
+	msleep(50);
+	fts_ts_suspend(ts_data->dev);
+	fts_ts_resume(ts_data->dev);
+}
+
 static int fb_notifier_callback(struct notifier_block *self, unsigned long event, void *data)
 {
 	int *blank = NULL;
@@ -1592,6 +1612,17 @@
 	register_early_suspend(&ts_data->early_suspend);
 #endif
 
+	/* FT8756 replacement panel boot revive (v6): schedule one
+	 * reset pulse + suspend->resume cycle 20 s after probe, so
+	 * touch comes up without a manual screen off/on. */
+	if (ts_data->ts_workqueue) {
+		INIT_DELAYED_WORK(&ts_data->boot_revive_work, fts_boot_revive_work);
+		queue_delayed_work(ts_data->ts_workqueue,
+				   &ts_data->boot_revive_work,
+				   msecs_to_jiffies(20000));
+	}
+
