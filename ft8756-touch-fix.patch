 }
 
+/* FT8756 (Huaxing) replacement screen: after boot the chip can be left
+ * dead because the first display-on resume never fires (the panel is
+ * already on when this driver registers its DRM notifier) and the
+ * probe-time reset hits the chip while its regulator is still off.
+ * The screen off/on toggle recovers it only because that cycle runs a
+ * real reset once the panel is powered. Check the chip shortly after
+ * probe and reset it until it answers, so a missed first resume does
+ * not leave touch dead until the user toggles the screen. */
+#define FTS_BOOT_CHECK_DELAY_MS	1000
+#define FTS_BOOT_CHECK_MAX_ATTEMPTS	10
+
+static void fts_boot_check_work(struct work_struct *work)
+{
+	struct fts_ts_data *ts_data = container_of(work, struct fts_ts_data,
+						    boot_check_work.work);
+	u8 idh = 0, idl = 0;
+	int ret;
+
+	if (!ts_data)
+		return;
+
+	ret = fts_read_reg(FTS_REG_CHIP_ID, &idh);
+	if (ret == 0)
+		ret = fts_read_reg(FTS_REG_CHIP_ID2, &idl);
+	if ((ret == 0) && (idh == ts_data->ic_info.ids.chip_idh) &&
+	    (idl == ts_data->ic_info.ids.chip_idl)) {
+		FTS_INFO("TP chip valid after boot check");
+		return;
+	}
+
+	FTS_INFO("TP chip not answering after boot, reset attempt %d",
+		 ts_data->boot_check_attempts + 1);
+	fts_reset_proc(200);
+	if (fts_wait_tp_to_valid() == 0) {
+		FTS_INFO("TP chip recovered after boot reset");
+		return;
+	}
+
+	if (++ts_data->boot_check_attempts < FTS_BOOT_CHECK_MAX_ATTEMPTS) {
+		queue_delayed_work(ts_data->ts_workqueue,
+				   &ts_data->boot_check_work,
+				   msecs_to_jiffies(FTS_BOOT_CHECK_DELAY_MS));
+	} else {
+		FTS_ERROR("TP chip still not answering after boot, giving up");
+	}
+}
+
 static int fb_notifier_callback(struct notifier_block *self, unsigned long event, void *data)
 {
 	int *blank = NULL;
@@ -1592,6 +1650,15 @@
 	register_early_suspend(&ts_data->early_suspend);
 #endif
 
+	/* FT8756 (Huaxing) in-cell panel: at probe time the chip is reset while
+	 * its regulator is still off, and the panel power-on that follows never
+	 * delivers a reset because fts_ts_resume() early-returns while
+	 * suspended is false. Mark the chip suspended here so the first
+	 * display-on (UNBLANK) runs the full resume path - the same reset +
+	 * re-init that the suspend/resume cycle performs on a screen off/on
+	 * toggle, which is what recovers the chip on the replacement screen. */
+	ts_data->suspended = true;
+
 #if LCT_TP_USB_PLUGIN
 	g_touchscreen_usb_pulgin.event_callback = fts_ts_usb_event_callback;
 #endif
@@ -1606,6 +1673,15 @@
 			dev_set_drvdata(ts_data->fts_touch_dev, ts_data);
 		}
 	}
+
+	/* FT8756: the first display-on resume may never fire (see
+	 * fts_boot_check_work); check the chip shortly after probe and
+	 * reset it until it answers. */
+	INIT_DELAYED_WORK(&ts_data->boot_check_work, fts_boot_check_work);
+	ts_data->boot_check_attempts = 0;
+	queue_delayed_work(ts_data->ts_workqueue, &ts_data->boot_check_work,
+			   msecs_to_jiffies(FTS_BOOT_CHECK_DELAY_MS));
+
 	FTS_FUNC_EXIT();
 	return 0;
 
@@ -1664,6 +1740,7 @@
 	free_irq(ts_data->irq, ts_data);
 	input_unregister_device(ts_data->input_dev);
 
+	cancel_delayed_work_sync(&ts_data->boot_check_work);
 	if (ts_data->ts_workqueue)
 		destroy_workqueue(ts_data->ts_workqueue);
 
@@ -1765,9 +1842,14 @@
 #if FTS_POWER_SOURCE_CUST_EN
 		fts_power_source_resume(ts_data);
 #endif
-		fts_reset_proc(200);
 	}
-	//fts_wait_tp_to_valid();
+	/* FT8756 is in-cell, so the reset above is skipped for it, but the
+	 * replacement panel only comes up clean after a real reset pulse plus
+	 * a settle delay once the panel is powered. Reset unconditionally
+	 * and wait until the chip answers with its id (max ~1s) before
+	 * re-enabling the irq and recovering ex-modes. */
+	fts_reset_proc(200);
+	fts_wait_tp_to_valid();
 	fts_ex_mode_recovery(ts_data);
 
 #if FTS_ESDCHECK_EN
