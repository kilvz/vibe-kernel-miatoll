diff --git a/drivers/input/touchscreen/ft8756_spi/focaltech_core.c b/drivers/input/touchscreen/ft8756_spi/focaltech_core.c
index 19fe51aa0..f3691df8b 100644
--- a/drivers/input/touchscreen/ft8756_spi/focaltech_core.c
+++ b/drivers/input/touchscreen/ft8756_spi/focaltech_core.c
@@ -623,6 +623,17 @@ static int fts_read_touchdata(struct fts_ts_data *data)
 		return 1;
 	} else if ((ret < 0) || ((buf[1] & 0xF0) != 0x90)) {
 		FTS_ERROR("touch data(%x) abnormal,ret:%d", buf[1], ret);
+		/* All-zero buffer with EIO: the chip lost its state after the
+		 * panel powered on (seen on the FT8756 replacement screen).
+		 * Try a state recovery, rate-limited to once per 5s so a dead
+		 * chip cannot reset-loop the irq thread. */
+		if ((ret < 0) && (buf[1] == 0x00)) {
+			static unsigned long last_recovery;
+			if (time_after(jiffies, last_recovery + 5 * HZ)) {
+				last_recovery = jiffies;
+				fts_tp_state_recovery(data);
+			}
+		}
 		return -EIO;
 	}
 
@@ -1592,6 +1603,15 @@ static int fts_ts_probe_entry(struct fts_ts_data *ts_data)
 	register_early_suspend(&ts_data->early_suspend);
 #endif
 
+	/* FT8756 (Huaxing) in-cell panel: at probe time the chip is reset while
+	 * its regulator is still off, and the panel power-on that follows never
+	 * delivers a reset because fts_ts_resume() early-returns while
+	 * suspended is false. Mark the chip suspended here so the first
+	 * display-on (UNBLANK) runs the full resume path - the same reset +
+	 * re-init that the suspend/resume cycle performs on a screen off/on
+	 * toggle, which is what recovers the chip on the replacement screen. */
+	ts_data->suspended = true;
+
 #if LCT_TP_USB_PLUGIN
 	g_touchscreen_usb_pulgin.event_callback = fts_ts_usb_event_callback;
 #endif
@@ -1765,9 +1785,14 @@ static int fts_ts_resume(struct device *dev)
 #if FTS_POWER_SOURCE_CUST_EN
 		fts_power_source_resume(ts_data);
 #endif
-		fts_reset_proc(200);
 	}
-	//fts_wait_tp_to_valid();
+	/* FT8756 is in-cell, so the reset above is skipped for it, but the
+	 * replacement panel only comes up clean after a real reset pulse plus
+	 * a settle delay once the panel is powered. Reset unconditionally
+	 * and wait until the chip answers with its id (max ~1s) before
+	 * re-enabling the irq and recovering ex-modes. */
+	fts_reset_proc(200);
+	fts_wait_tp_to_valid();
 	fts_ex_mode_recovery(ts_data);
 
 #if FTS_ESDCHECK_EN
